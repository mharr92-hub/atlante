// Atlante del Pacifico — modelo de datos.
//
// Atlante es un broker: no cobra y no opera embarcaciones. Lo que el sitio
// público escribe hoy es `Lead` (intención de compra), `Handoff` (token de un
// solo uso hacia PEX) y `PexEvent` (log del webhook de confirmación).
//
// `Booking`, `Payment`, `AvailabilitySlot`, `Customer`, `Coupon`, `GiftCard`,
// `Review` y `Reseller` vienen del modelo anterior de reservas propias: se
// conservan para no perder datos, pero ya no los usa ninguna ruta pública.
//
// Provider: Postgres (proyecto Supabase "ATLANTE").
// Las migraciones se aplican fuera de este repo (`prisma migrate deploy`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: pooled connection (Transaction pooler, port 6543) for the
  // runtime client on serverless; direct connection (port 5432) for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum BookingFlow {
  whatsapp_request
  manual_payment
  charter_request
}

enum PaymentMethod {
  cash
  transfer
  manual
  refund
}

enum SlotStatus {
  available
  full
  blocked
  maintenance
}

/// A purchasable date/time for a given tour, with remaining capacity.
/// Capacity is decremented inside a transaction (SELECT ... FOR UPDATE) at
/// booking time, as in prod.
model AvailabilitySlot {
  id                String     @id @default(uuid())
  tourSlug          String
  date              DateTime   @db.Date
  timeSlot          String?
  capacity          Int
  capacityRemaining Int
  priceOverride     Decimal?   @db.Decimal(10, 2)
  status            SlotStatus @default(available)
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  bookings          Booking[]

  @@unique([tourSlug, date, timeSlot])
  @@index([tourSlug, date])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([email])
}

/// Central booking aggregate.
model Booking {
  id                 String        @id @default(uuid())
  tourSlug           String
  bookingFlow        BookingFlow   @default(whatsapp_request)
  status             BookingStatus @default(pending)
  paymentStatus      PaymentStatus @default(unpaid)

  bookingDate        DateTime      @db.Date
  timeSlot           String?
  guestCount         Int

  // Snapshot of per-guest pricing so historical bookings stay immutable.
  passengerBreakdown Json?
  selectedAddons     Json?

  totalPrice         Decimal       @db.Decimal(10, 2)
  depositAmount      Decimal       @db.Decimal(10, 2)
  depositPaid        Boolean       @default(false)
  balancePaid        Boolean       @default(false)

  // Public lookup + boarding
  confirmationToken  String        @unique
  boardingCode       String?       @unique

  // Idempotency + optional external payment reference (unused without a gateway)
  paymentRef         String?
  idempotencyKey     String?       @unique

  // Contact + waiver
  customerName       String
  customerEmail      String
  customerPhone      String?
  hotelPickup        String?
  dietaryNotes       String?
  emergencyContact   String?
  waiverSignedAt     DateTime?

  // Attribution / affiliate
  couponCode         String?
  referralCode       String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?

  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  slotId             String?
  slot               AvailabilitySlot? @relation(fields: [slotId], references: [id])
  payments           Payment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  @@index([status, paymentStatus])
  @@index([bookingDate])
}

/// One row per recorded payment (cash / bank transfer / manual mark-paid).
/// providerRef stays unique so a future gateway can use it as an idempotency key.
model Payment {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(manual)
  providerRef  String?       @unique
  refundAmount Decimal?      @db.Decimal(10, 2)
  refundRef    String?
  notes        String?
  collectedBy  String?
  createdAt    DateTime      @default(now())
}

/// Email capture / newsletter (feeds campaign sends).
/// R1 renamed it: `Lead` is now the purchase-intent model below.
model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?
  locale    String?
  createdAt DateTime @default(now())

  @@map("Subscriber")
}

/// Post-trip reviews (auto-requested by email after a confirmed booking).
model Review {
  id         String   @id @default(uuid())
  bookingId  String?
  name       String
  stars      Int
  text       String
  tourSlug   String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// Promo / coupon codes.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  percentOff     Int?
  amountOff      Decimal?  @db.Decimal(10, 2)
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

/// Gift cards / certificates.
model GiftCard {
  id            String    @id @default(uuid())
  code          String    @unique
  initialValue  Decimal   @db.Decimal(10, 2)
  balance       Decimal   @db.Decimal(10, 2)
  purchaserName String?
  recipientName String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

/// Partner / affiliate accounts (hotels, agencies) with commission tracking.
model Reseller {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  referralCode     String   @unique
  commissionPercent Decimal @db.Decimal(5, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ============================================================================
// R1 — broker de Pacific Experience
//
// El sitio público ya no crea `Booking`: crea un `Lead` (intención de compra)
// y un `Handoff` (token de un solo uso) antes de redirigir a PEX. `PexEvent`
// es el log idempotente del webhook de confirmación.
// ============================================================================

enum LeadStatus {
  created
  redirected
  paid
  paid_unmatched
  lost
  quote_requested
  quoted
  accepted
}

enum LeadType {
  tour
  party
  ferry
  charter_pex
  charter_partner
}

/// Intención de compra capturada en el paso 3 del funnel, antes del handoff.
model Lead {
  id       String   @id @default(cuid())
  type     LeadType

  productSlug String?
  vesselSlug  String?

  serviceDate DateTime? @db.Date
  timeSlot    String?
  /// Id de la salida de PEX elegida en modo integrado (`ProductSlot.pexSlotId`).
  pexSlotId   String?
  /// Cantidad por categoría de precio: { "adulto-nacional": 2, ... }
  pax         Json?
  paxTotal    Int?
  /// Slugs de adicionales seleccionados.
  addons      Json?

  /// Charters (R2): jornada pedida, en horas (4, 8, 12).
  hours    Int?
  /// Charters (R2): clave de ocasión (cumpleanos, despedida, corporativo…).
  occasion String?

  name  String
  email String
  phone String

  partnerCode String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPath String?
  /// URL a PEX con la que se redirigió (para el rescate por WhatsApp).
  destinationUrl String?

  status LeadStatus @default(created)

  pexBookingId     String?  @unique
  amount           Decimal? @db.Decimal(10, 2)
  commissionPct    Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal? @db.Decimal(10, 2)
  notes            String?

  createdAt    DateTime  @default(now())
  redirectedAt DateTime?
  paidAt       DateTime?
  updatedAt    DateTime  @updatedAt

  handoffs Handoff[]
  events   PexEvent[]

  @@index([status, createdAt])
  @@index([email])
  @@index([serviceDate])
}

/// Token de un solo uso para que PEX prellene el checkout sin PII en la URL.
model Handoff {
  token     String   @id
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// Log del webhook de PEX. `(pexBookingId, eventType)` da la idempotencia.
model PexEvent {
  id           String   @id @default(cuid())
  pexBookingId String
  eventType    String
  payload      Json
  signatureOk  Boolean
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([pexBookingId, eventType])
  @@index([leadId])
}

// ============================================================================
// R1c — catálogo en base de datos y espejo del feed de PEX
//
// `Product` es el espejo del tipo `Product` de `src/content/catalog.ts`: los
// textos bilingües y las listas viajan como JSON `{ es, en }` / `Localized[]`,
// tal como los consume el sitio. `src/lib/catalog.ts` lee de aquí cuando hay
// filas y cae al catálogo en código cuando no (regla 9).
//
// `ProductSlot` es la copia del feed X4 de PEX (`/slots`). Mientras esté vacío
// o con `syncedAt` de más de 24 h, el funnel sigue en modo puente.
// ============================================================================

/// Producto del catálogo (ticketería y naves de PEX).
model Product {
  id     String @id @default(cuid())
  slug   String @unique
  kind   String
  source String @default("pex")

  /// Identificador del trip en PEX; habilita el deep link al checkout.
  pexTripId String?
  pexPath   String
  /// Slug de nave para `charter_checkout` (aura, pacific-ferry-1, …).
  pexVessel String?

  /// Textos bilingües: { "es": "…", "en": "…" }.
  name        Json
  summary     Json
  description Json

  priceFrom          Decimal  @db.Decimal(10, 2)
  priceUnit          String
  /// [{ key, label: { es, en }, price, note? }]
  priceTable         Json?
  pricePerPersonFrom Decimal? @db.Decimal(10, 2)

  durationMin   Int?
  durationLabel Json

  /// { weekdays: [5,6,0], times: [{ start, end }], validFrom?, note? }
  schedule    Json?
  capacityMin Int?
  capacityMax Int?

  /// Listas de textos bilingües: [{ es, en }, …]
  includes    Json?
  notIncluded Json?
  policies    Json?
  /// ["/foto-1.jpg", …]
  images      Json?
  /// ["family", "evening", …]
  badges      Json?

  available     Boolean   @default(true)
  /// Día en que el dato se contrastó contra PEX (aviso en admin a los 14 días).
  verifiedAt    DateTime? @db.Date
  sourceUrl     String?
  /// Comisión de Atlante para este producto; sin valor manda ATLANTE_COMMISSION_PCT.
  commissionPct Decimal?  @db.Decimal(5, 2)
  order         Int       @default(0)
  /// Última vez que el cron copió este producto del feed de PEX.
  syncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addons ProductAddon[]
  slots  ProductSlot[]

  @@index([available, order])
}

/// Adicional de un producto (BBQ, open bar, tour por las islas…).
model ProductAddon {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  slug        String
  name        Json
  description Json?
  price       Decimal @db.Decimal(10, 2)
  /// per_person | per_booking | pending (PEX no publica la unidad).
  unit        String  @default("per_person")
  durationMin Int?
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, slug])
}

/// Salida real copiada del feed de PEX. Su existencia activa el modo integrado.
model ProductSlot {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  pexSlotId         String   @unique
  date              DateTime @db.Date
  startTime         String
  endTime           String?
  capacityRemaining Int
  price             Decimal? @db.Decimal(10, 2)
  syncedAt          DateTime @default(now())

  @@index([productId, date])
  @@index([date])
}

/// Alta self-service de operadores de charter (marketplace, bloque 4/R2).
model PartnerApplication {
  id         String   @id @default(cuid())
  /// operator | hotel | agency — las tres propuestas de `/aliados`.
  kind       String   @default("operator")
  name       String
  vesselName String?
  capacity   Int?
  zone       String?
  whatsapp   String
  email      String?
  photos     Json?
  message    String?
  status     String   @default("new")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

// ============================================================================
// R2 — marketplace de charters
//
// `Operator` es quien opera y cobra la nave (hoy sólo Pacific Experience);
// `Vessel` es la ficha pública. `src/lib/vessels.ts` lee de aquí cuando hay
// filas y cae a `src/content/vessels.ts` cuando no (regla 9).
//
// `commissionPct`, `contractSignedAt`, `ampLicense` e `insuranceUntil` son
// internos: nunca se muestran en público. El sello "Operador verificado" sólo
// aparece con licencia AMP, seguro vigente y contrato firmado.
// ============================================================================

/// Operador de las naves del marketplace. `pex` es el primer registro.
model Operator {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  whatsapp String?
  email    String?

  commissionPct    Decimal?  @db.Decimal(5, 2)
  contractSignedAt DateTime? @db.Date
  ampLicense       String?
  insuranceUntil   DateTime? @db.Date

  verified Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessels Vessel[]
}

/// Nave del marketplace: ficha pública, tabla de precios y modo de cierre.
model Vessel {
  id         String   @id @default(cuid())
  slug       String   @unique
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  name        String
  /// Clave de tipo: catamaran | ferry | no_publicado …
  type        String
  lengthFt    Int?
  capacityMax Int
  marina      String

  /// [{ route, hours, capacityMax, price }] — precio del barco completo.
  pricing   Json
  /// ["bahia", "taboga", "perlas"]
  routes    Json
  /// [{ es, en }, …]
  includes  Json
  /// [{ label: { es, en }, price?, unit? }] — extras bajo solicitud.
  onRequest Json

  depositPct         Int  @default(30)
  /// { es, en }
  cancellationPolicy Json

  photos Json
  video  String?

  /// deeplink = checkout de PEX con `ref`; quote = cotización de Atlante.
  closeMode             String   @default("quote")
  pexVesselSlug         String?
  pexPath               String?
  /// "desde $X/persona" publicado por PEX, cuando lo publica.
  pexPricePerPersonFrom Decimal? @db.Decimal(10, 2)

  /// { es, en } — textos de la ficha.
  summary     Json?
  description Json?

  verifiedAt DateTime? @db.Date
  sourceUrl  String?
  active     Boolean   @default(true)
  order      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([operatorId])
}
