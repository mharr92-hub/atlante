# Copia este archivo a .env.local y rellena los valores. No subas .env.local al repo.
# El sitio publico funciona sin ninguna de estas variables: si falta la base de
# datos, la navegacion y el paso al operador siguen funcionando.

# Postgres (Supabase "ATLANTE") a traves del pooler, puerto 6543. Lo usa la app en runtime.
DATABASE_URL=

# Postgres directo, puerto 5432. Lo usa Prisma para migraciones.
DIRECT_URL=

# Contrasena unica de /admin.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesion del admin (cadena aleatoria larga).
AUTH_SECRET=

# URL publica canonica del sitio, con https y sin barra final.
NEXT_PUBLIC_SITE_URL=

# Identificador de Google Analytics 4 (G-XXXXXXXXXX). Sin el, GA4 no se carga.
NEXT_PUBLIC_GA_ID=

# Identificador del pixel de Meta. Sin el, el pixel no se carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Base de Pacific Experience para buildPexUrl(). Por defecto usa el dominio de produccion.
NEXT_PUBLIC_PEX_BASE_URL=

# Secreto compartido con PEX para resolver el token de prellenado (h=) servidor a servidor.
PEX_HANDOFF_SECRET=

# Secreto compartido con PEX para validar la firma del webhook de reserva confirmada.
PEX_WEBHOOK_SECRET=

# Comision de Atlante sobre las reservas de PEX, en porcentaje. Por defecto 20.
ATLANTE_COMMISSION_PCT=

# Secreto que protege las rutas de cron (sincronizacion del catalogo de PEX).
CRON_SECRET=
