// Atlante del Pacifico — modelo de datos.
//
// Atlante es un broker: no cobra y no opera embarcaciones. Lo que el sitio
// público escribe hoy es `Lead` (intención de compra), `Handoff` (token de un
// solo uso hacia PEX) y `PexEvent` (log del webhook de confirmación).
//
// `Booking`, `Payment`, `AvailabilitySlot`, `Customer`, `Coupon`, `GiftCard`,
// `Review` y `Reseller` vienen del modelo anterior de reservas propias: se
// conservan para no perder datos, pero ya no los usa ninguna ruta pública.
//
// Provider: Postgres (proyecto Supabase "ATLANTE").
// Las migraciones se aplican fuera de este repo (`prisma migrate deploy`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: pooled connection (Transaction pooler, port 6543) for the
  // runtime client on serverless; direct connection (port 5432) for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum BookingFlow {
  whatsapp_request
  manual_payment
  charter_request
}

enum PaymentMethod {
  cash
  transfer
  manual
  refund
}

enum SlotStatus {
  available
  full
  blocked
  maintenance
}

/// A purchasable date/time for a given tour, with remaining capacity.
/// Capacity is decremented inside a transaction (SELECT ... FOR UPDATE) at
/// booking time, as in prod.
model AvailabilitySlot {
  id                String     @id @default(uuid())
  tourSlug          String
  date              DateTime   @db.Date
  timeSlot          String?
  capacity          Int
  capacityRemaining Int
  priceOverride     Decimal?   @db.Decimal(10, 2)
  status            SlotStatus @default(available)
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  bookings          Booking[]

  @@unique([tourSlug, date, timeSlot])
  @@index([tourSlug, date])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([email])
}

/// Central booking aggregate.
model Booking {
  id                 String        @id @default(uuid())
  tourSlug           String
  bookingFlow        BookingFlow   @default(whatsapp_request)
  status             BookingStatus @default(pending)
  paymentStatus      PaymentStatus @default(unpaid)

  bookingDate        DateTime      @db.Date
  timeSlot           String?
  guestCount         Int

  // Snapshot of per-guest pricing so historical bookings stay immutable.
  passengerBreakdown Json?
  selectedAddons     Json?

  totalPrice         Decimal       @db.Decimal(10, 2)
  depositAmount      Decimal       @db.Decimal(10, 2)
  depositPaid        Boolean       @default(false)
  balancePaid        Boolean       @default(false)

  // Public lookup + boarding
  confirmationToken  String        @unique
  boardingCode       String?       @unique

  // Idempotency + optional external payment reference (unused without a gateway)
  paymentRef         String?
  idempotencyKey     String?       @unique

  // Contact + waiver
  customerName       String
  customerEmail      String
  customerPhone      String?
  hotelPickup        String?
  dietaryNotes       String?
  emergencyContact   String?
  waiverSignedAt     DateTime?

  // Attribution / affiliate
  couponCode         String?
  referralCode       String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?

  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  slotId             String?
  slot               AvailabilitySlot? @relation(fields: [slotId], references: [id])
  payments           Payment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  @@index([status, paymentStatus])
  @@index([bookingDate])
}

/// One row per recorded payment (cash / bank transfer / manual mark-paid).
/// providerRef stays unique so a future gateway can use it as an idempotency key.
model Payment {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(manual)
  providerRef  String?       @unique
  refundAmount Decimal?      @db.Decimal(10, 2)
  refundRef    String?
  notes        String?
  collectedBy  String?
  createdAt    DateTime      @default(now())
}

/// Email capture / newsletter (feeds campaign sends).
/// R1 renamed it: `Lead` is now the purchase-intent model below.
model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?
  locale    String?
  createdAt DateTime @default(now())

  @@map("Subscriber")
}

/// Post-trip reviews (auto-requested by email after a confirmed booking).
model Review {
  id         String   @id @default(uuid())
  bookingId  String?
  name       String
  stars      Int
  text       String
  tourSlug   String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// Promo / coupon codes.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  percentOff     Int?
  amountOff      Decimal?  @db.Decimal(10, 2)
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

/// Gift cards / certificates.
model GiftCard {
  id            String    @id @default(uuid())
  code          String    @unique
  initialValue  Decimal   @db.Decimal(10, 2)
  balance       Decimal   @db.Decimal(10, 2)
  purchaserName String?
  recipientName String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

/// Partner / affiliate accounts (hotels, agencies) with commission tracking.
model Reseller {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  referralCode     String   @unique
  commissionPercent Decimal @db.Decimal(5, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ============================================================================
// R1 — broker de Pacific Experience
//
// El sitio público ya no crea `Booking`: crea un `Lead` (intención de compra)
// y un `Handoff` (token de un solo uso) antes de redirigir a PEX. `PexEvent`
// es el log idempotente del webhook de confirmación.
// ============================================================================

enum LeadStatus {
  created
  redirected
  paid
  paid_unmatched
  lost
  quote_requested
  quoted
  accepted
}

enum LeadType {
  tour
  party
  ferry
  charter_pex
  charter_partner
}

/// Intención de compra capturada en el paso 3 del funnel, antes del handoff.
model Lead {
  id       String   @id @default(cuid())
  type     LeadType

  productSlug String?
  vesselSlug  String?

  serviceDate DateTime? @db.Date
  timeSlot    String?
  /// Cantidad por categoría de precio: { "adulto-nacional": 2, ... }
  pax         Json?
  paxTotal    Int?
  /// Slugs de adicionales seleccionados.
  addons      Json?

  name  String
  email String
  phone String

  partnerCode String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPath String?
  /// URL a PEX con la que se redirigió (para el rescate por WhatsApp).
  destinationUrl String?

  status LeadStatus @default(created)

  pexBookingId     String?  @unique
  amount           Decimal? @db.Decimal(10, 2)
  commissionPct    Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal? @db.Decimal(10, 2)
  notes            String?

  createdAt    DateTime  @default(now())
  redirectedAt DateTime?
  paidAt       DateTime?
  updatedAt    DateTime  @updatedAt

  handoffs Handoff[]
  events   PexEvent[]

  @@index([status, createdAt])
  @@index([email])
  @@index([serviceDate])
}

/// Token de un solo uso para que PEX prellene el checkout sin PII en la URL.
model Handoff {
  token     String   @id
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// Log del webhook de PEX. `(pexBookingId, eventType)` da la idempotencia.
model PexEvent {
  id           String   @id @default(cuid())
  pexBookingId String
  eventType    String
  payload      Json
  signatureOk  Boolean
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([pexBookingId, eventType])
  @@index([leadId])
}

/// Alta self-service de operadores de charter (marketplace, bloque 4/R2).
model PartnerApplication {
  id         String   @id @default(cuid())
  name       String
  vesselName String?
  capacity   Int?
  zone       String?
  whatsapp   String
  email      String?
  photos     Json?
  status     String   @default("new")
  createdAt  DateTime @default(now())
}
