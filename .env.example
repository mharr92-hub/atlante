# Atlante del Pacifico — local / Vercel env
#
# Phase 1 marketing pages run without these. Charter deposit checkout needs
# DATABASE_URL + PagueloFácil vars. Preview can ship without them: the form
# still captures the lead (logs) and /gracias shows pago=pendiente.

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Pooled URL for the serverless Prisma client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct URL for migrations / prisma db push (port 5432 on Supabase).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Public origin (no trailing slash) ───────────────────────────────────────
# Used for PagueloFácil RETURN_URL and customer redirects after payment.
PUBLIC_APP_URL="https://www.atlantedelpacifico.lat"
# Optional alias — same value as PUBLIC_APP_URL if you prefer the Next public prefix.
# NEXT_PUBLIC_APP_URL="https://www.atlantedelpacifico.lat"

# ── PagueloFácil Enlace de Pago ─────────────────────────────────────────────
# Same pattern as PEX catamaran-rentals PaymentsService (NOT static button links):
#   1. Server POST LinkDeamon.cfm → single-use hosted URL
#   2. Browser redirects there
#   3. PF hits RETURN_URL (GET) and/or webhook (POST) with Oper — hints only
#   4. Confirm via MerchantTransactions S2S (RAW Authorization token, no "Bearer ")
#
# TODO: keep src/lib/paguelofacil.ts aligned with
# catamaran-rentals/backend/src/modules/payments/payments.service.ts
# when porting remaining PEX behavior (reconciliation cron, expired-recovery).
#
# PAGUELOFACIL_CCLW: merchant web code from PagueloFácil.
# PAGUELOFACIL_API_TOKEN: MerchantTransactions token. Send RAW in Authorization
#   (do not prefix "Bearer " — that returns 410 Invalid Api Key).
# PAGUELOFACIL_API_URL: LinkDeamon. Prod default below; sandbox:
#   https://sandbox.paguelofacil.com/LinkDeamon.cfm
# PAGUELOFACIL_VERIFY_URL: MerchantTransactions host. Prod default below; sandbox:
#   https://sandbox.paguelofacil.com
# PAGUELOFACIL_RETURN_URL: optional override. If empty, derived as
#   ${PUBLIC_APP_URL}/api/payments/paguelofacil/return
#
# Webhook: there is NO env var. In the PagueloFácil dashboard (Notificaciones)
# set POST https://www.atlantedelpacifico.lat/api/payments/paguelofacil/webhook
PAGUELOFACIL_CCLW=
PAGUELOFACIL_API_TOKEN=
PAGUELOFACIL_API_URL=https://secure.paguelofacil.com/LinkDeamon.cfm
PAGUELOFACIL_VERIFY_URL=https://admin.paguelofacil.com
PAGUELOFACIL_RETURN_URL=

# ── Optional marketing ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# ADMIN_PASSWORD=
